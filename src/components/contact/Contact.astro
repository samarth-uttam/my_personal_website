---
import { site } from "../../data/site.js";
const { tagline, email, links } = site.contact;
---
<section id="contact" class="band">
  <div class="container inner">
    <div>
      <p class="label">Contact</p>
      <p class="tagline">{tagline}</p>
    </div>
    <div>
      <p class="label">Write to me</p>
      <div class="email-row">
        <a class="email" href={`mailto:${email}`}>{email}</a>
        <button class="copy" type="button" data-email={email}>Copy</button>
      </div>
      <p class="label elsewhere">Elsewhere</p>
      <ul class="links">
        {links.map((link) => (
          <li><a href={link.href} target="_blank" rel="noopener">{link.label} ↗</a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>(".copy");
  button?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(button.dataset.email ?? "");
    button.textContent = "Copied";
    setTimeout(() => (button.textContent = "Copy"), 1500);
  });
</script>

<style>
  .band {
    margin-top: 120px;
    padding: 96px 0;
    background: var(--text);
    color: var(--bg);
  }
  .inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
  }
  .label {
    margin: 0 0 16px;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .tagline {
    margin: 0;
    max-width: 16ch;
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    font-weight: 300;
    line-height: 1.1;
  }
  .email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .email {
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    overflow-wrap: anywhere;
    transition: opacity 0.2s;
  }
  .email:hover { opacity: 0.6; }
  .copy {
    font: inherit;
    font-size: 0.8rem;
    color: inherit;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    padding: 4px 14px;
    cursor: pointer;
    transition: border-color 0.2s;
  }
  .copy:hover { border-color: var(--bg); }
  .elsewhere { margin-top: 48px; }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .links a {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 999px;
    font-size: 0.9rem;
    transition: background 0.2s, color 0.2s;
  }
  .links a:hover {
    background: var(--bg);
    color: var(--text);
  }

  @media (max-width: 800px) {
    .band {
      margin-top: 80px;
      padding: 64px 0;
    }
    .inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
</style>