---
import CvEntry from "./CvEntry.astro";
import type { Props as Entry } from "./CvEntry.astro";

interface Props {
  title: string;
  entries: Entry[];
  plain?: boolean;
}
const { title, entries, plain = false } = Astro.props;
---
<section>
  <h2>{title}</h2>
  <div class:list={["entries", { plain }]}>
    {entries.map((entry) => <CvEntry {...entry} plain={plain} />)}
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 24px;
    margin-bottom: 56px;
  }
  .entries {
    border-top: 1px solid var(--line);
  }
  .entries.plain {
    border-top: none;
    padding-top: 18px;
  }
  h2 {
    margin: 0;
    padding-top: 28px;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    section {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>