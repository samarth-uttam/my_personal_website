<div class="lightbox" hidden>
  <figure class="stage">
    <img alt="" />
    <div class="placeholder"></div>
    <figcaption></figcaption>
  </figure>
  <button class="prev" type="button" aria-label="Previous image">‹</button>
  <button class="next" type="button" aria-label="Next image">›</button>
  <button class="close" type="button" aria-label="Close">×</button>
</div>

<script>
  const box = document.querySelector<HTMLElement>(".lightbox");
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>("[data-lightbox]")];

  if (box && thumbs.length > 0) {
    const img = box.querySelector("img")!;
    const placeholder = box.querySelector<HTMLElement>(".placeholder")!;
    const caption = box.querySelector("figcaption")!;
    let current = 0;

    const show = (index: number) => {
      current = (index + thumbs.length) % thumbs.length;
      const { src, caption: text = "" } = thumbs[current].dataset;
      img.hidden = !src;
      placeholder.hidden = Boolean(src);
      if (src) {
        img.src = src;
        img.alt = text;
      }
      caption.textContent = `${text} · ${current + 1} / ${thumbs.length}`;
    };

    const open = (index: number) => {
      show(index);
      box.hidden = false;
      document.body.style.overflow = "hidden";
    };

    const close = () => {
      box.hidden = true;
      document.body.style.overflow = "";
    };

    thumbs.forEach((thumb, index) => thumb.addEventListener("click", () => open(index)));

    box.querySelector(".prev")!.addEventListener("click", (event) => {
      event.stopPropagation();
      show(current - 1);
    });
    box.querySelector(".next")!.addEventListener("click", (event) => {
      event.stopPropagation();
      show(current + 1);
    });
    box.addEventListener("click", close);

    document.addEventListener("keydown", (event) => {
      if (box.hidden) return;
      if (event.key === "Escape") close();
      if (event.key === "ArrowLeft") show(current - 1);
      if (event.key === "ArrowRight") show(current + 1);
    });

    let startX = 0;
    box.addEventListener("touchstart", (event) => {
      startX = event.touches[0].clientX;
    });
    box.addEventListener("touchend", (event) => {
      const distance = event.changedTouches[0].clientX - startX;
      if (Math.abs(distance) > 50) show(current + (distance < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(17, 17, 17, 0.95);
    color: #fff;
  }
  .lightbox[hidden],
  .stage [hidden] {
    display: none;
  }
  .stage {
    margin: 0;
    text-align: center;
  }
  img {
    display: block;
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
  }
  .placeholder {
    width: min(80vw, 900px);
    aspect-ratio: 4 / 3;
    background: #333;
  }
  figcaption {
    margin-top: 12px;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
  }
  button {
    position: absolute;
    padding: 16px;
    border: none;
    background: none;
    color: inherit;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s;
  }
  button:hover {
    opacity: 1;
  }
  .prev {
    left: 8px;
  }
  .next {
    right: 8px;
  }
  .close {
    top: 8px;
    right: 8px;
    font-size: 2rem;
  }
</style>