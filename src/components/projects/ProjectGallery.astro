---
import ProjectRow from "./ProjectRow.astro";

type Credit = string | string[] | undefined;

interface Props {
  groups: {
    title: string;
    text?: string;
    images: { src?: string; caption: string; credit?: string | string[] }[];
  }[];
}
const { groups } = Astro.props;
const creditLines = (credit: Credit) => (credit ? (Array.isArray(credit) ? credit : [credit]) : []);
---
{groups.map((group) => (
  <ProjectRow label={group.title}>
    {group.text && <p class="text">{group.text}</p>}
    <div class="images">
      {group.images.map((image) => (
        <figure>
          <button
            type="button"
            data-lightbox
            data-src={image.src}
            data-caption={image.caption}
            data-credit={creditLines(image.credit).join("\n") || undefined}
            aria-label={`Open image: ${image.caption}`}
          >
            {image.src ? (
              <img src={image.src} alt={image.caption} loading="lazy" />
            ) : (
              <span class="placeholder"></span>
            )}
          </button>
          <figcaption>
            {image.caption}
            {creditLines(image.credit).map((line) => (
              <span class="credit">{line}</span>
            ))}
          </figcaption>
        </figure>
      ))}
    </div>
  </ProjectRow>
))}

<style>
  .text {
    margin: 0 0 24px;
  }
  .images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px 16px;
  }
  figure {
    margin: 0;
  }
  button {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }
  img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    transition: opacity 0.2s;
  }
  img {
    object-fit: contain;
  }
  .placeholder {
    background: var(--line);
  }
  button:hover img,
  button:hover .placeholder {
    opacity: 0.8;
  }
  figcaption {
    margin-top: 8px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .credit {
    display: block;
    margin-top: 2px;
    font-size: 0.75rem;
    opacity: 0.8;
  }
</style>