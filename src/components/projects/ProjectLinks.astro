---
interface Props {
  links: { label: string; href: string }[];
}
const { links } = Astro.props;
const newTab = (href: string) => href.startsWith("http") || href.endsWith(".pdf");
---
<ul>
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        target={newTab(link.href) ? "_blank" : undefined}
        rel={newTab(link.href) ? "noopener" : undefined}
      >{link.label} ↗</a>
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    border-bottom: 1px solid var(--text);
    transition: opacity 0.2s;
  }
  a:hover {
    opacity: 0.4;
  }
</style>