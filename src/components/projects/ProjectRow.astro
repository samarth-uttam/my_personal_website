---
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<section class="row">
  <h2>{label}</h2>
  <div class="content">
    <slot />
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 24px;
    margin-top: 56px;
  }
  h2 {
    margin: 0;
    padding-top: 24px;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .content {
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 800px) {
    .row {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 40px;
    }
    h2 {
      padding-top: 0;
    }
  }
</style>