---
import ProjectGrid from "../projects/ProjectGrid.astro";
import { getFeaturedProjects } from "../../lib/projects.js";

const projects = await getFeaturedProjects();
---
<section class="container" id="work">
  <h2>Selected work</h2>
  <ProjectGrid projects={projects} />
  <a class="all" href="/research">All projects →</a>
</section>

<style>
  section {
    margin-top: 120px;
  }
  h2 {
    margin: 0 0 32px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .all {
    display: inline-block;
    margin-top: 56px;
    border-bottom: 1px solid var(--text);
    transition: opacity 0.2s;
  }
  .all:hover { opacity: 0.4; }
</style>