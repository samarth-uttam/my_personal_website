---
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import ProjectHeader from "../../components/projects/ProjectHeader.astro";
import ProjectRow from "../../components/projects/ProjectRow.astro";
import ProjectFacts from "../../components/projects/ProjectFacts.astro";
import ProjectFigures from "../../components/projects/ProjectFigures.astro";
import ProjectLinks from "../../components/projects/ProjectLinks.astro";
import ProjectGallery from "../../components/projects/ProjectGallery.astro";
import Lightbox from "../../components/projects/Lightbox.astro";
import NextProject from "../../components/projects/NextProject.astro";
import { getAllProjects } from "../../lib/projects";

export async function getStaticPaths() {
  const projects: CollectionEntry<"projects">[] = await getAllProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: { project, next: projects[(index + 1) % projects.length] },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
  next: CollectionEntry<"projects">;
}

const { project, next } = Astro.props;
const { title, summary, cover, facts, links, figures, gallery } = project.data;
const { Content } = await render(project);
---
<Base title={`${title} — Samarth Uttam`}>
  <article class="container">
    <ProjectHeader title={title} summary={summary} cover={cover} />

    {facts.length > 0 && (
      <ProjectRow label="Details">
        <ProjectFacts facts={facts} />
      </ProjectRow>
    )}

    {figures.length > 0 && (
      <ProjectRow label="Key figures">
        <ProjectFigures figures={figures} />
      </ProjectRow>
    )}

    <div class="prose">
      <Content />
    </div>

    {links.length > 0 && (
      <ProjectRow label="Links">
        <ProjectLinks links={links} />
      </ProjectRow>
    )}

    <ProjectGallery groups={gallery} />

    <NextProject project={next} />
  </article>
  <Lightbox />
</Base>

<style>
  .prose {
    display: grid;
    grid-template-columns: 1fr 3fr;
    column-gap: 24px;
  }
  .prose > :global(*) {
    grid-column: 2;
    margin: 0 0 14px;
  }
  .prose > :global(h2) {
    grid-column: 1;
    margin: 56px 0 0;
    padding-top: 24px;
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .prose > :global(h2 + *) {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .prose :global(a) {
    border-bottom: 1px solid var(--text);
  }

  @media (max-width: 800px) {
    .prose {
      display: block;
    }
    .prose > :global(h2) {
      margin: 40px 0 12px;
      padding-top: 0;
    }
    .prose > :global(h2 + *) {
      margin-top: 0;
    }
  }
</style>